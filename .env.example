# -----------------------------------------------------------------------------
# Variáveis de ambiente — copie para ".env" (ou ".env.local") e preencha.
# Na Vercel: Project > Settings > Environment Variables (mesmos nomes).
# -----------------------------------------------------------------------------

# Supabase > Project Settings > Data API (URL do projeto)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase > Project Settings > API Keys
# Use a chave PÚBLICA: "publishable" (sb_publishable_...) ou a antiga "anon" (eyJ...).
# Ela pode ir para o navegador; quem protege os dados são as regras RLS do schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica

# Endereço do app, sem barra no final. Local: http://localhost:3002
# Na Vercel: o domínio final, ex.: https://app.seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# (Opcional) Link do botão "Assinar" quando o teste/plano vence:
# checkout (Hotmart, Kiwify, Mercado Pago, Stripe…), WhatsApp ou página de vendas.
NEXT_PUBLIC_LINK_ASSINATURA=

# (Opcional, mas recomendado) Chave SECRETA — só no servidor, nunca com NEXT_PUBLIC_.
# Supabase > Project Settings > API Keys > "secret" (sb_secret_...) ou a antiga "service_role".
# Libera, no painel /admin, criar clientes com senha provisória, enviar convites e excluir contas.
SUPABASE_SERVICE_ROLE_KEY=
